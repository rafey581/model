# Copy this file to packages/server/.env for local development:
#   cp .env.example packages/server/.env
#
# Production must set every value below and replace the secret placeholders.
# The server refuses to start without DATABASE_URL, JWT_SECRET and COOKIE_SECRET.

# PostgreSQL connection string (docker compose starts one on localhost:5432)
DATABASE_URL=postgresql://snooker:snooker@localhost:5432/snooker

# REQUIRED in production. Use long random values (>=16 chars).
#   openssl rand -hex 32
JWT_SECRET=change-me-in-production-at-least-16-chars
COOKIE_SECRET=change-me-in-production-at-least-16-chars

# HTTP port for the API + Socket.IO server
PORT=4000

# Comma-separated list of allowed browser origins (CORS, credentials allowed)
CLIENT_ORIGIN=http://localhost:5173

# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Virtual-credit starting balance for new player wallets
CR_START_BALANCE=1000

# Server-authoritative turn timer (seconds) and reconnect grace window (seconds)
MATCH_TURN_TIMEOUT_SEC=60
MATCH_RECONNECT_GRACE_SEC=120

# Cashout-style commission the pool takes on winnings (0.10 = 10%)
COMMISSION_PCT=0.10

# Stake ceiling limits (100 CR = $1 table at tier 1)
MIN_STAKE=100
MAX_STAKE=1000

# Keeps real-money/crypto settlement disabled. Do NOT enable without licensed
# legal setup in the target jurisdiction.
REAL_MONEY_ENABLED=false

# --- Player auth (OTP over email / WhatsApp) ------------------------------
# A code proves the email address or WhatsApp number a player signed up with.
# A short code and a short life are the whole defence; tighten for production.
OTP_TTL_SEC=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SEC=30

# Internal no-OTP registration route. Tests, e2e and the seed use it; turn it OFF
# in production so every account goes through the OTP signup flow.
AUTH_ALLOW_DIRECT_REGISTER=true

# Email delivery (SMTP). Leave SMTP_HOST empty and codes are written to the server
# log instead of emailed, which is what makes a fresh checkout work offline.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Snooker Arena <no-reply@snooker.test>

# WhatsApp delivery. `none` logs codes to the server log; `twilio` posts to the
# Twilio WhatsApp API and needs the three credentials below.
WHATSAPP_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Admin access ---------------------------------------------------------
# TOTP is required by default; disabling it is an explicit, logged decision.
ADMIN_REQUIRE_TOTP=true
# Comma-separated IP prefixes allowed to reach the admin login. Empty = anywhere.
ADMIN_ALLOWED_IPS=
ADMIN_SESSION_TTL_MIN=30