# Copy this file to packages/server/.env for local development:
#   cp .env.example packages/server/.env
#
# Production must set every value below and replace the secret placeholders.
# The server refuses to start without DATABASE_URL, JWT_SECRET and COOKIE_SECRET.

# PostgreSQL connection string (docker compose starts one on localhost:5432)
DATABASE_URL=postgresql://snooker:snooker@localhost:5432/snooker

# REQUIRED in production. Use long random values (>=16 chars).
#   openssl rand -hex 32
JWT_SECRET=change-me-in-production-at-least-16-chars
COOKIE_SECRET=change-me-in-production-at-least-16-chars

# HTTP port for the API + Socket.IO server
PORT=4000

# Comma-separated list of allowed browser origins (CORS, credentials allowed)
CLIENT_ORIGIN=http://localhost:5173

# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Welcome grant for new wallets, in USDT (1 USDT = 1 balance unit)
START_BALANCE=1

# Server-authoritative turn timer (seconds) and reconnect grace window (seconds)
MATCH_TURN_TIMEOUT_SEC=60
MATCH_RECONNECT_GRACE_SEC=120

# Cashout-style commission the pool takes on winnings (0.10 = 10%)
COMMISSION_PCT=0.10

# Stake ceiling limits in USDT. Must span the stake tiers (1, 5, 10).
MIN_STAKE=1
MAX_STAKE=10

# --- Invitations (referral programme) -------------------------------------
REFERRAL_ENABLED=true
REFERRAL_BONUS_USDT=1
# Whether a practice match counts as the invitee's "first real match"
REFERRAL_COUNT_PRACTICE=false

# --- Deposits (manual USDT on Solana) -------------------------------------
# Players send USDT to this address, then submit the tx id + a proof screenshot.
# Leave the address empty and the deposit screen says "not configured".
DEPOSIT_ENABLED=true
DEPOSIT_NETWORK=SOL
DEPOSIT_CURRENCY=USDT
DEPOSIT_WALLET_ADDRESS=
DEPOSIT_MIN_USDT=5
DEPOSIT_MAX_USDT=1000
DEPOSIT_SCREENSHOT_MAX_BYTES=4194304

# --- Withdrawals (manual USDT on Solana) ----------------------------------
# The player names their own address; an admin pays out and approves, which
# debits the balance at approval time.
WITHDRAW_ENABLED=true
WITHDRAW_NETWORK=SOL
WITHDRAW_CURRENCY=USDT
WITHDRAW_MIN_USDT=5
WITHDRAW_MAX_USDT=1000
WITHDRAW_MATCH_SNAPSHOT_COUNT=5

# Gates only the unimplemented crypto endpoints (/api/crypto/*, which answer 501).
# It does NOT switch off money movement: the manual deposit/withdraw flows are
# controlled by DEPOSIT_ENABLED and WITHDRAW_ENABLED above. Turning those on means
# real USDT changes hands, so do not enable them without licensed legal setup in
# the target jurisdiction.
REAL_MONEY_ENABLED=false

# --- Player auth (OTP over email) -----------------------------------------
# A code proves the email address a player signed up with.
# A short code and a short life are the whole defence; tighten for production.
OTP_TTL_SEC=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SEC=30

# Internal no-OTP registration route (tests, e2e, scripts). Enabled by default so
# players can create an account directly in the game with email + username + password.
# Set AUTH_ALLOW_DIRECT_REGISTER=false to disable signup routes.
AUTH_ALLOW_DIRECT_REGISTER=true

# One-tap throwaway guest accounts (no email, phone or password). Guests cannot
# withdraw. Production: false. Local dev: true if you want the guest button.
AUTH_ALLOW_GUEST=false

# Email delivery (SMTP). This is the ONLY delivery channel for verification and
# password-reset codes, so set it in production. Leave SMTP_HOST empty and codes are
# written to the server log instead of emailed, which is what makes a fresh checkout
# work offline.
#   - Gmail: smtp.gmail.com, 465 with SMTP_SECURE=true (or 587 with false) and a
#     16-character App Password as SMTP_PASS (2-Step Verification required).
#   - Mailbox on your own domain: the provider's SMTP host, usually port 465 or 587
#     with the mailbox password.
# SMTP_FROM should use the same address as SMTP_USER, or providers will reject it.
# Staff phone alerts: new deposit/withdrawal requests ring the admin app (Expo push).
# EXPO_ACCESS_TOKEN is only needed if "Enhanced push security" is on for the Expo project.
ADMIN_PUSH_ENABLED=true
EXPO_ACCESS_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Snooker Arena <no-reply@snooker.test>

# --- Admin access ---------------------------------------------------------
# Sign-in is email + password only (no authenticator app). Protect the account
# with a strong unique password; the lockout below is the brute-force defence.
# Comma-separated IP prefixes allowed to reach the admin login. Empty = anywhere,
# which is fine locally but should be set to your office/VPN range in production.
ADMIN_ALLOWED_IPS=
ADMIN_SESSION_TTL_MIN=30
# Failed logins before the account (and separately the IP) is locked, and for how
# long. An IP gets 3x the account budget because NAT shares one address.
ADMIN_MAX_FAILED_ATTEMPTS=5
ADMIN_LOCKOUT_MIN=15
# Browser origins allowed to call the admin API (only needed for Expo web).
ADMIN_APP_ORIGINS=http://localhost:8081,http://localhost:19006