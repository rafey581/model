{
  "appId": "com.snookerx.game",
  "appName": "Snooker Stake",
  "webDir": "dist",
  "server": {
    "androidScheme": "http",
    "cleartext": true
  },
  "android": {
    "backgroundColor": "#03050b",
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
