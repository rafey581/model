# Absolute URL of the game server's API, including the /api suffix.
#
# Leave this blank on a phone running through Expo Go: the app reads the Expo dev
# server host (your computer's LAN address) and talks to port 4000 there. Set it
# explicitly when the server is somewhere else, or when running the web build.
#
#   EXPO_PUBLIC_API_URL=http://192.168.1.10:4000/api
#
# EXPO_PUBLIC_API_URL=
#
# Standalone (EAS) builds do not read this file. The value is baked in at build
# time from the `env` block in eas.json, because a release build has no Metro dev
# server to infer the host from.
